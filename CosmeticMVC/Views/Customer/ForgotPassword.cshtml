@model CosmeticMVC.ViewModels.LoginVM

@{
    Layout = "_LayoutAuthentication";
    ViewData["Title"] = "Quên mật khẩu";
}

<div id="forgotPasswordPage">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow-lg border-0 rounded-lg mt-5">
                    <div class="card-header">
                        <h3 class="text-center font-weight-light my-4">Đặt lại mật khẩu</h3>
                    </div>
                    <div class="card-body">
                        <div class="small mb-3 text-muted">Nhập email của bạn để đặt lại mật khẩu</div>
                        <form asp-action="ForgotPassword" asp-controller="Customer" method="post">
                            <div class="form-floating mb-3">
                                <input asp-for="UserName" class="form-control" id="inputEmail" placeholder="name@example.com" required />
                                <label for="inputEmail">Địa chỉ email</label>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                <a class="small" asp-controller="Customer" asp-action="Login">Trở về đăng nhập</a>
                                <button class="btn btn-primary" type="submit">Đặt lại mật khẩu</button>
                            </div>
                        </form>
                    </div>
                    <div class="card-footer text-center py-3">
                        <div class="small"><a asp-action="Registry" asp-controller="Customer">Bạn chưa có tài khoản? Đăng ký!</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>