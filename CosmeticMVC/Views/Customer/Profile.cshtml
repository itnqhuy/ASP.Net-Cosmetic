@model CosmeticMVC.ViewModels.UpdateProfileVM

@{
    ViewData["Title"] = "Cập nhật thông tin cá nhân";
    Layout = "_LayoutCustomer";
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/HinhAnh/breadcrumb.png")">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Cosmetic Shop</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                        <span>Cập nhật thông tin cá nhân</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Profile Update Form Begin -->
<section class="contact-form spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="contact__form__title">
                    <h2>Cập nhật thông tin cá nhân</h2>
                </div>
            </div>
        </div>
        <form asp-action="UpdateProfile" asp-controller="Customer" method="post" enctype="multipart/form-data">
            <div class="form-row avatar-row">
                <div class="avatar-container">
                    <div class="avatar-preview">
                        <img id="avatarImage" src="@Url.Content("~/HinhAnh/Customer/")@Model.Avatar"  alt="Ảnh đại diện" />
                    </div>
                    <input asp-for="Avatar" type="file" id="avatarUpload" name="Hinh" class="form-control-file" />
                    <span asp-validation-for="Avatar" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-6">
                    <input asp-for="FullName" placeholder="Họ và tên" class="form-control"/>
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-lg-6 col-md-6">
                    <input asp-for="Email" placeholder="Email" class="form-control" readonly/>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-lg-6 col-md-6">
                    <input asp-for="Phone" placeholder="Số điện thoại" class="form-control"/>
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-lg-6 col-md-6">
                    <input asp-for="Address" placeholder="Địa chỉ" class="form-control"/>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="col-lg-12 text-center">
                    <button type="submit" class="site-btn">Cập nhật thông tin</button>
                </div>
            </div>
        </form>
    </div>
</section>
<!-- Profile Update Form End -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const avatarInput = document.getElementById('avatarUpload');
        const avatarImage = document.getElementById('avatarImage');

        avatarInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
                if (allowedTypes.includes(file.type)) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        avatarImage.src = e.target.result; // Set the image source to the uploaded file
                    };
                    reader.readAsDataURL(file);
                } else {
                    alert('Vui lòng chọn một tệp ảnh hợp lệ (JPG, PNG, GIF).');
                    this.value = ''; // Reset the file input
                }
            }
        });
    });
</script>
