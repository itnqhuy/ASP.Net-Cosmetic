@model CosmeticMVC.ViewModels.DetailPostVM

@{
    ViewData["Title"] = "Chi tiết bài viết";
    Layout = "_LayoutCustomer";
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/HinhAnh/breadcrumb.png")">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Cosmetic Shop</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                        <a asp-controller="Post" asp-action="Index">Diễn đàn</a>
                        <span>@Model.Content</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Blog Details Begin -->
<section class="blog-details spad">
    <div class="container">
        <div class="blog__details__text">
            <h3>@Html.Raw(@Model.Description)</h3>
            <img src="~/HinhAnh/Product/@Model.Image" alt="@Model.Name_product" class="img-fluid">
            <p>@Model.Content</p>
        </div>
        <div class="blog__details__content">
            <div class="row">
                <div class="col-lg-6">
                    <div class="blog__details__author">
                        <div class="blog__details__author__text">
                            <h6>@Model.Name_product</h6>
                            <span>Đã chỉnh sửa: @Model.Modified_at.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="blog__details__widget">
                        <ul>
                            <li><span>Bắt đầu:</span> @Model.Datebegin.ToString("dd/MM/yyyy")</li>
                            <li><span>Ẩn bài viết:</span> @(Model.Hide == 1 ? "Có" : "Không")</li>
                            <li><span>Meta:</span> @Model.Meta</li>
                        </ul>
                        <div class="blog__details__social">
                            <a href="#"><i class="fa fa-facebook"></i></a>
                            <a href="#"><i class="fa fa-twitter"></i></a>
                            <a href="#"><i class="fa fa-google-plus"></i></a>
                            <a href="#"><i class="fa fa-linkedin"></i></a>
                            <a href="#"><i class="fa fa-envelope"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Blog Details End -->
