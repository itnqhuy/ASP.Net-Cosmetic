@model IEnumerable<CosmeticMVC.ViewModels.ListPostVM>

@{
    ViewData["Title"] = "Diễn đàn";
    Layout = "_LayoutCustomer";
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/HinhAnh/breadcrumb.png")">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Cosmetic Shop</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller ="Home" asp-action="Index">Trang chủ</a>
                        <span>Diễn đàn</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->

<!-- Blog Section Begin -->
<section class="blog spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-5">
                <div class="blog__sidebar">
                    <div class="blog__sidebar__search">
                        <form asp-controller="Post" asp-action="Search">
                            <input type="text" placeholder="Search..." name="query">
                            <button type="submit"><span class="icon_search"></span></button>
                        </form>
                    </div>
                    <div class="hero__categories">
                        <div class="hero__categories__all">
                            <i class="fa fa-bars"></i>
                            <span>Loại sản phẩm</span>
                        </div>
                        @await Component.InvokeAsync("MenuCategory")
                    </div>
                    <div class="hero__brands">
                        <div class="hero__brands__all">
                            <i class="fa fa-bars"></i>
                            <span>Thương hiệu</span>
                        </div>
                        @await Component.InvokeAsync("MenuBrand")
                    </div>
                    <div class="blog__sidebar__item"></div>
                    <div class="blog__sidebar__item">
                        <h4>Phổ biến</h4>
                        <div class="blog__sidebar__item__tags">
                            <a asp-controller="Post" asp-action="Search" asp-route-query="Cream">Cream</a>
                            <a asp-controller="Post" asp-action="Search" asp-route-query="Serum">Serum</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8 col-md-7">
                @await Html.PartialAsync("PostItem")

            </div>
        </div>
    </div>
</section>
<!-- Blog Section End -->
