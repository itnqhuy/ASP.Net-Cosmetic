@model IEnumerable<CosmeticMVC.ViewModels.ListProductVM>

@foreach (var m in Model)
{
    <div class="col-lg-4 col-md-6 col-sm-6">
        <div class="product__item">
            <div class="product__item__pic set-bg" data-setbg="@Url.Content("~/HinhAnh/Product/" + m.Image)">
                <ul class="product__item__pic__hover">
                    <li><a href="#"><i class="fa fa-heart"></i></a></li>
                    <li><a href="#"><i class="fa fa-retweet"></i></a></li>
                    <li><a asp-action="AddToCartItem" asp-controller="CartItem" asp-route-id="@m.Id"><i class="fa fa-shopping-cart"></i></a></li>
                </ul>
            </div>
            <div class="product__item__text">
                <h6><a asp-controller="Product" asp-action="Detail" asp-route-id="@m.Id">@m.Name</a></h6>
                <h5>@m.Price</h5>
            </div>
        </div>
    </div>
}