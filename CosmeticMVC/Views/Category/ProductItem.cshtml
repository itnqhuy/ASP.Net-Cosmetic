@model X.PagedList.IPagedList<CosmeticMVC.ViewModels.ListProductVM>
@using X.PagedList.Mvc.Core

<div class="row">
    @foreach (var m in Model)
    {
        <div class="col-lg-4 col-md-6 col-sm-6">
            <div class="product__item">
                <div class="product__item__pic set-bg" data-setbg="@Url.Content("~/HinhAnh/Product/" + m.Image)">
                    <ul class="product__item__pic__hover">
                        <li><a asp-controller="Favourite" asp-action="AddToCartItem" asp-route-id="@m.Id"><i class="fa fa-heart"></i></a></li>
                        <li><a asp-controller="Post" asp-action="Add"><i class="fa fa-retweet"></i></a></li>
                        <li>
                            <a href="javascript:void(0);" onclick="addToCart('@m.Id')">
                                <i class="fa fa-shopping-cart"></i>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="product__item__text">
                    <h6><a asp-controller="Product" asp-action="Detail" asp-route-meta="@m.Meta" asp-route-id="@m.Id">@m.Name</a></h6>
                    <h5>@m.Price</h5>
                </div>
            </div>
        </div>
    }
</div>

<!-- Pagination controls -->
<nav aria-label="Page navigation">
    <ul class="pagination pagination-md justify-content-center product__pagination">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1 })" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
        }

        @for (int i = 1; i <= Model.PageCount; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
            </li>
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1 })" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        }
    </ul>
</nav>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function showNotification(message, isError = false) {
        var notification = $('#notification');
        notification.text(message);
        notification.removeClass('error');

        if (isError) {
            notification.addClass('error');
        }

        notification.fadeIn(400).delay(2000).fadeOut(400); // Hiển thị trong 2 giây rồi mờ dần
    }

    function addToCart(productId) {
        var quantity = 1; // Mặc định là 1, có thể thay đổi nếu bạn có input chọn số lượng

        // Tạo URL đúng với tham số {id} và {quantity}
        var url = '/gio-hang/them-vao-gio-hang-' + productId + '-' + quantity;

        $.ajax({
            url: url,
            type: 'POST',
            data: { id: productId, quantity: quantity },
            success: function (response) {
                if (response.success) {
                    // Hiển thị thông báo thành công
                    showNotification("Sản phẩm đã được thêm vào giỏ hàng!");
                    updateCartQuantity(response.cartQuantity);
                } else {
                    // Hiển thị thông báo lỗi
                    showNotification(response.message, true);
                }
            },
            error: function (xhr, status, error) {
                console.error(error);
                showNotification("Vui lòng đăng nhập để thêm sản phẩm vào giỏ hàng", true);
            }
        });
    }
</script>


<style>
    .notification {
        position: fixed;
        top: 20px;
        right: 20px;
        background-color: #7FAD39; /* Màu nền xanh lá cho thông báo thành công */
        color: white;
        padding: 10px;
        border-radius: 5px;
        display: none; /* Ban đầu ẩn */
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        z-index: 1000;
    }

        .notification.error {
            background-color: #f44336; /* Màu nền đỏ cho thông báo lỗi */
        }

</style>

