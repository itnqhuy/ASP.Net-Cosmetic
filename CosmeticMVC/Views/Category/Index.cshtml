@model IEnumerable<CosmeticMVC.ViewModels.ListProductVM>
@{
    ViewData["Title"] = "Cửa hàng";
    Layout = "_ListProduct";
    var productCount = Model.Count();
}

@section Header
{
    <!-- Breadcrumb Section Begin -->
    <section class="breadcrumb-section set-bg" data-setbg="@Url.Content("HinhAnh/breadcrumb.png")">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <div class="breadcrumb__text">
                        <h2>Cosmetic Shop</h2>
                        <div class="breadcrumb__option">
                            <a asp-controller="Home" asp-action="Index">Trang Chủ </a>
                            <span>Cửa hàng</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Breadcrumb Section End -->
}
<div class="filter__item">
    <div class="row">
        <div class="col-lg-6 col-md-6">
            <div class="filter__sort">
                <span>Sort By</span>
                <form method="get">
                    <select name="sortOrder">
                        <option value="0" selected>Default</option>
                        <option value="1">Giá giảm dần</option>
                        <option value="2">Giá tăng dần</option>
                    </select>
                </form>
            </div>
        </div>
        <div class="col-lg-6 col-md-6">
            <div class="filter__found">
                <h6><span>@productCount</span> sản phẩm được tìm thấy</h6>
            </div>
        </div>
    </div>
</div>
<div class="row">
    @await Html.PartialAsync("ProductItem")
</div>
<div class="product__pagination">
    <a href="#">1</a>
    <a href="#">2</a>
    <a href="#">3</a>
    <a href="#"><i class="fa fa-long-arrow-right"></i></a>
</div>
