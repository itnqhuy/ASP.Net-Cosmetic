@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!-- Humberger Begin -->
<div class="humberger__menu__overlay"></div>
<div class="humberger__menu__wrapper">
    <div class="humberger__menu__logo" >
        <a asp-controller="Home" asp-action="Index"><img src="~/HinhAnh/logo.png" alt="" style="margin-left : 50px !important"></a>
    </div>
    <div class="humberger__menu__cart">
        <ul>
            @await Component.InvokeAsync("Cart")
        </ul>
    </div>
    <div class="humberger__menu__widget">

        <div class="header__top__right__auth">
            @if (User.Identity.IsAuthenticated)
            {
                <a asp-action="Profile" asp-controller="Customer"><i class="fa fa-user"></i> @User.Identity.Name |</a>
                <a asp-action="LogOut" asp-controller="Customer"><i class="fa fa-sign-out"></i> Đăng xuất</a>
            }
            else
            {
                <a asp-action="Login" asp-controller="Customer"><i class="fa fa-user"></i> Đăng nhập |</a>
                <a asp-action="Login" asp-controller="Staff"><i class="fa fa-user"></i> Admin</a>
            }
        </div>

    </div>
    <div class="col-lg-6">
        <nav class="header__menu text-center">
            <ul>
                <li class="@(currentController == "Home" ? "active" : "")"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="@(currentController == "Category" ? "active" : "")"><a asp-controller="Category" asp-action="Index">Cửa hàng</a></li>
                <li class="@(currentController == "CartItem" || currentController == "Checkout" ? "active" : "")">
                    <a href="#">Trang</a>
                    <ul class="header__menu__dropdown">
                        <li><a asp-controller="CartItem" asp-action="Index">Giỏ hàng</a></li>
                        <li><a asp-controller ="Order" asp-action="Index">Lịch sử đơn hàng</a></li>
                        <li><a asp-action ="Profile" asp-controller="Customer">Thông tin cá nhân</a></li>
                    </ul>
                </li>
                <li class="@(currentController == "Post" ? "active" : "")">
                    <a asp-controller="Post" asp-action="Index">Diễn đàn</a>
                </li>
                <li class="@(currentController == "Contact" ? "active" : "")"><a asp-controller="Contact" asp-action="Index">Liên hệ</a></li>

            </ul>
        </nav>
    </div>
    <div id="mobile-menu-wrap"></div>
    <div class="header__top__right__social">
        <a href="#"><i class="fa fa-facebook"></i></a>
        <a href="#"><i class="fa fa-twitter"></i></a>
        <a href="#"><i class="fa fa-linkedin"></i></a>
        <a href="#"><i class="fa fa-pinterest-p"></i></a>
    </div>
    <div class="humberger__menu__contact">
        <ul>
            <li><i class="fa fa-envelope"></i><a href="mailto:hello@colorlib.com">abcxyz@gmail.com</a></li>
            <li>Miễn phí giao hàng cho các đơn hàng từ 200.000đ</li>
        </ul>
    </div>
</div>
<!-- Humberger End -->
<!-- Header Section Begin -->
<header class="header">
    <div class="header__top">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 col-md-6">
                    <div class="header__top__left">
                        <ul>
                            <li><i class="fa fa-envelope"></i>abcxyz@gmail.com</li>
                            <li>Miễn phí giao hàng cho các đơn hàng từ 200.000đ</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6">
                    <div class="header__top__right">
                        <div class="header__top__right__social">
                            <a href="#"><i class="fa fa-facebook"></i></a>
                            <a href="#"><i class="fa fa-twitter"></i></a>
                            <a href="#"><i class="fa fa-linkedin"></i></a>
                            <a href="#"><i class="fa fa-pinterest-p"></i></a>
                        </div>
                        <div class="header__top__right__auth">

                        </div>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="header__top__right__auth">
                                <a asp-action="Profile" asp-controller="Customer"><i class="fa fa-user"></i> @User.Identity.Name   |</a>

                            </div>
                            <div class="header__top__right__auth">
                                <a asp-action="LogOut" asp-controller="Customer"><i class="fa fa-sign-out"></i> Đăng xuất</a>

                            </div>
                        }
                        else
                        {
                            <div class="header__top__right__auth">
                                <a asp-action="Login" asp-controller="Customer"><i class="fa fa-user"></i> Đăng nhập |</a>

                            </div>
                            <div class="header__top__right__auth">
                                <a asp-action="Login" asp-controller="Staff"><i class="fa fa-user"></i> Admin</a>

                            </div>
                        }


                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="header__logo">
                    <a asp-controller="Home" asp-action="Index"><img src="~/HinhAnh/logo.png" alt="" style="margin-left : 5px !important"></a>
                </div>
            </div>
            <div class="col-lg-7">
                <nav class="header__menu">
                    <ul>
                        <li class="@(currentController == "Home" ? "active" : "")"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="@(currentController == "Category" ? "active" : "")"><a asp-controller="Category" asp-action="Index">Cửa hàng</a></li>
                        <li class="@(currentController == "CartItem" || currentController == "Checkout" ? "active" : "")">
                            <a href="#">Trang</a>
                            <ul class="header__menu__dropdown">
                                <li><a asp-controller="CartItem" asp-action="Index">Giỏ hàng</a></li>
                                <li><a asp-controller ="Order" asp-action="Index">Lịch sử đơn hàng</a></li>
                                <li><a asp-action ="Profile" asp-controller="Customer">Thông tin cá nhân</a></li>
                            </ul>
                        </li>
                        <li class="@(currentController == "Post" ? "active" : "")">
                            <a asp-controller="Post" asp-action="Index">Diễn đàn</a>
                        </li>
                        <li class="@(currentController == "Contact" ? "active" : "")"><a asp-controller="Contact" asp-action="Index">Liên hệ</a></li>

                    </ul>
                </nav>
            </div>
            <div class="col-lg-2">
                <div class="header__cart">
                    <ul>
                        @await Component.InvokeAsync("Cart")
                        </ul>
                </div>
            </div>
        </div>
        <div class="humberger__open">
            <i class="fa fa-bars"></i>
        </div>
    </div>
</header>
<!-- Header Section End -->

<style>
    .avatar-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 20px;
    }

    .avatar-preview {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid #ddd;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
        background-color: #f7f7f7;
    }

    .avatar-preview {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid #ddd;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f7f7f7;
        margin-bottom: 10px;
        margin-left: auto; /* Added */
        margin-right: auto; /* Added */
    }

    .avatar-upload {
        text-align: center;
    }

    .avatar-row {
        justify-content: center; /* Centers the content vertically (if necessary) */
        text-align: center;
    }

    .form-control-file {
        margin-top: 10px; /* Tùy chỉnh khoảng cách trên nếu cần */
    }
</style>