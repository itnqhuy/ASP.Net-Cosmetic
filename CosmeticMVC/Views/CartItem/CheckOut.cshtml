@model IEnumerable<CosmeticMVC.ViewModels.ListCartItemVM>

@{
    ViewData["Title"] = "CheckOut";
    Layout = "_LayoutCustomer";
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/HinhAnh/breadcrumb.png")">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Cosmetic Shop</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="CartItem" asp-action="Index">Giỏ hàng</a>
                        <span>Thanh toán</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Checkout Section Begin -->
<section class="checkout spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h6>
                    <span class="icon_tag_alt"></span> Have a coupon? <a href="#">Nhấn vào đây</a> để nhập mã giảm giá
                </h6>
            </div>
        </div>

        <div class="checkout__form">
            <h4>Chi tiết hóa đơn</h4>

            <form asp-controller="CartItem" asp-action="Checkout" method="post">
                <div class="form-check my-3">
                    <input type="checkbox" name="GiongKhachHang" class="form-check-input" id="GiongKhachHang" value="false">
                    <label class="form-check-label" for="GiongKhachHang">Giống thông tin khách hàng?</label>
                </div>

                <div class="row">
                    <div class="col-lg-6 col-md-6">
                        <div class="checkout-input-fields">
                            <div class="checkout__input">
                                <p>Họ và tên<span>*</span></p>
                                <input type="text" name="HoTen" id="fullName" class="form-control">
                            </div>
                            <div class="checkout__input">
                                <p>Địa chỉ<span>*</span></p>
                                <input type="text" name="DiaChi" id="address" class="form-control" placeholder="Địa chỉ nhà">
                            </div>
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="checkout__input">
                                        <p>Số điện thoại<span>*</span></p>
                                        <input type="text" name="DienThoai" id="phone" class="form-control">
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="checkout__input">
                                        <p>Email<span>*</span></p>
                                        <input type="email" name="Email" id="email" class="form-control">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="checkout__input">
                            <p>Lưu ý đơn hàng<span>*</span></p>
                            <input type="text" name="GhiChu" id="orderNotes" class="form-control" placeholder="Những điều bạn cần dặn dò...">
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6">
                        <div class="checkout__order">
                            <h4>Hóa đơn của bạn</h4>
                            <div class="checkout__order__products">Products <span>Total</span></div>
                            <ul>
                                @foreach (var item in Model)
                                {
                                    <li>@item.ProductName <span>@item.TotalProduct</span></li>
                                }
                            </ul>

                            <div class="checkout__order__subtotal">Tổng cộng <span>@Model.Sum(item => item.TotalProduct)</span></div>
                            <div class="checkout__order__total">Tổng tiền <span>@Model.Sum(item => item.TotalProduct)</span></div>

                            <button type="submit" class="site-btn">XÁC NHẬN ĐẶT HÀNG</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
<!-- Checkout Section End -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('#GiongKhachHang').on('change', function () {
            if ($(this).is(':checked')) {
                $(this).val(true);
                $('.checkout-input-fields').hide(); // Ẩn các trường thông tin cá nhân
            } else {
                $(this).val(false);
                $('.checkout-input-fields').show(); // Hiện các trường thông tin cá nhân
            }
        });
    });
</script>
