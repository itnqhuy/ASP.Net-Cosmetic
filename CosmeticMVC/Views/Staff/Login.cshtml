@model CosmeticMVC.ViewModels.StaffVM

@{
    Layout = "_LayoutAuthentication";
    ViewData["Title"] = "Đăng nhập";
}

<div id="loginPage">
    <div class="login-container bg-light card shadow-sm">
        <div class="logo-container">
            <a asp-controller="Home" asp-action="Index"><img src="~/HinhAnh/logo.png" alt="Logo" class="logo"></a>
            <h2 class="welcome-text">Welcome Back!</h2>
            <p class="subtitle">Please log in to continue.</p>
        </div>
        <form asp-action="Login" asp-controller="Staff" method="post" class="login-form">
            <div class="input-group">
                <input asp-for="UserName" type="email" placeholder="Tên đăng nhập" class="input-field">
                <i class="fa fa-envelope input-icon"></i>
            </div>
            <div class="input-group">
                <input asp-for="Password" type="password" placeholder="Mật khẩu" class="input-field">
                <i class="fa fa-lock input-icon"></i>
            </div>
            <div class="form-options">
                <label>
                    <input type="checkbox" name="remember" class="checkbox"> Nhớ tài khoản
                </label>
                <a asp-controller="Staff" asp-action="ForgotPassword" class="forgot-password">Quên mật khẩu?</a>
            </div>
            <button type="submit" class="btn-login">Đăng nhập</button>
        </form>
        <hr class="divider">
        <div class="signup-text">
            Bạn chưa có tài khoản? <a asp-action="Registry" asp-controller="Staff" class="signup-link">Đăng ký</a>
        </div>
    </div>
</div>

<style>
    /* General Styles */
    body {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        background: #fff !important;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    #loginPage {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    /* Login Container */
    .login-container {
        border-radius: 10px;
        padding: 30px;
        width: 550px;
        text-align: center;
    }

    .logo-container .logo {
        width: 100px;
        margin-bottom: 10px;
    }

    .welcome-text {
        color: #333;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .subtitle {
        color: #666;
        font-size: 14px;
        margin-bottom: 20px;
    }

    /* Form Styles */
    .login-form {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .input-group {
        position: relative;
    }

    .input-field {
        width: 100%;
        padding: 10px 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 14px;
    }

    .input-icon {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: #aaa;
    }

    .form-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
    }

    .checkbox {
        margin-right: 5px;
    }

    .forgot-password {
        color: #007bff;
        text-decoration: none;
    }

    /* Button Styles */
    .btn-login {
        background: #007bff;
        color: #fff;
        padding: 10px 15px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s ease;
    }

        .btn-login:hover {
            background: #0056b3;
        }

    /* Divider and Signup Link */
    .divider {
        margin: 20px 0;
        border: none;
        border-top: 1px solid #ddd;
    }

    .signup-text {
        font-size: 14px;
        color: #666;
    }

    .signup-link {
        color: #007bff;
        text-decoration: none;
    }

        .signup-link:hover {
            text-decoration: underline;
        }
</style>
