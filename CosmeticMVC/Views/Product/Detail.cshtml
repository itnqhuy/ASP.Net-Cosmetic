@model CosmeticMVC.ViewModels.ListProductVM.DetailProductVM

@{
    ViewData["Title"] = "Detail";
    Layout = "_LayoutCustomer";
}
<div id="notification" class="notification"></div>

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/HinhAnh/breadcrumb.png")">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Cosmetic Shop</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Trang Chủ </a>
                        <a asp-controller="Category" asp-action="Index"> Cửa hàng </a>
                        <span>@Model.Name</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->

<!-- Product Details Section Begin -->
<section class="product-details spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6">
                <div class="product__details__pic">
                    <div class="product__details__pic__item">
                        <img class="product__details__pic__item--large"
                             src="@Url.Content("~/HinhAnh/Product/")@Model.Image" alt="">
                    </div>
                    <div class="product__details__pic__slider owl-carousel">
                        @foreach (var i in new[] { 1, 2, 3, 4 })
                        {
                            <img data-imgbigurl="@Url.Content($"~/HinhAnh/Product/Details/{Model.Name}/detail{@i}.jpg")"
                                 src="@Url.Content($"~/HinhAnh/Product/Details/{Model.Name}/detail{@i}.jpg")"
                                 alt="Image @i">
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <div class="product__details__text">
                    <h3>@Model.Name</h3>
                    <div class="product__details__rating">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star-half-o"></i>
                        <span>(18 reviews)</span>
                    </div>
                    <div class="product__details__price">@Model.Price đ</div>
                    <p>
                        @Model.NameBrand
                    </p>
                    <form id="add-to-cart-form" asp-action="AddToCartItem" asp-controller="CartItem" asp-route-id="@Model.Id" method="post">
                        <div class="product__details__quantity">
                            <div class="quantity">
                                <div class="pro-qty">
                                    <input type="number" value="1" name="quantity" id="quantity-input" min="1">
                                </div>
                            </div>
                        </div>
                        <button class="primary-btn" type="submit">Thêm vào giỏ hàng</button>
                        <a href="#" class="heart-icon"><span class="icon_heart_alt"></span></a>
                    </form>

                    <ul>
                        <li><b>Tổng số lượt bán</b> <span>@Model.TotalSold</span></li>
                        <li><b>Ngày sản xuất</b> <span>@Model.Mfg</span></li>
                        <li><b>Hạn sử dụng</b> <span>@Model.Exp</span></li>
                        <li>
                            <b>Share on</b>
                            <div class="share">
                                <a href="#"><i class="fa fa-facebook"></i></a>
                                <a href="#"><i class="fa fa-twitter"></i></a>
                                <a href="#"><i class="fa fa-instagram"></i></a>
                                <a href="#"><i class="fa fa-pinterest"></i></a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="product__details__tab">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-toggle="tab" href="#tabs-1" role="tab"
                               aria-selected="true">Chi tiết</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="tab" href="#tabs-2" role="tab"
                               aria-selected="false">Thành phần</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="tab" href="#tabs-3" role="tab"
                               aria-selected="false">Đánh giá</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane active" id="tabs-1" role="tabpanel">
                            <div class="product__details__tab__desc">
                                <h6>Chi tiết</h6>
                                <p>
                                    @Html.Raw(Model.Description)
                                </p>
                            </div>
                        </div>
                        <div class="tab-pane" id="tabs-2" role="tabpanel">
                            <div class="product__details__tab__desc">
                                <h6>Thành phần</h6>
                                <p>
                                    @Model.DetailIngredient
                                </p>
                            </div>
                        </div>
                        <div class="tab-pane" id="tabs-3" role="tabpanel">
                            <div class="product__details__tab__desc">
                                <h6>Đánh giá</h6>
                                <div class="column">
                                    @await Component.InvokeAsync("ListRate")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Product Details Section End -->

<!-- Related Product Section Begin -->
<section class="related-product">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title related__product__title">
                    <h2>Related Product</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var product in ViewBag.RelatedProducts)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="product__item">
                        <div class="product__item__pic set-bg" data-setbg="@Url.Content("~/HinhAnh/Product/")@product.Image">
                            <ul class="product__item__pic__hover">
                                <li><a href="#"><i class="fa fa-heart"></i></a></li>
                                <li><a href="#"><i class="fa fa-retweet"></i></a></li>
                                <li><a asp-action="Detail" asp-route-id="@product.Id"><i class="fa fa-shopping-cart"></i></a></li>
                            </ul>
                        </div>
                        <div class="product__item__text">
                            <h6><a asp-action="Detail" asp-route-id="@product.Id">@product.Name</a></h6>
                            <h5>@product.Price đ</h5>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('#add-to-cart-form').submit(function (event) {
            event.preventDefault(); // Ngừng việc gửi form mặc định

            // Lấy giá trị của quantity từ input
            var quantity = $('#quantity-input').val();

            // Lấy giá trị của product id từ route
            var productId = '@Model.Id';  // Lấy ID từ Razor model

            // Tạo URL động cho action AddToCartItem
            var url = '/gio-hang/them-vao-gio-hang-' + productId + '-' + quantity;

            // Gửi request Ajax
            $.ajax({
                url: url,
                type: 'POST',
                data: { id: productId, quantity: quantity },
                success: function (response) {
                    if (response.success) {
                        showNotification("Sản phẩm đã được thêm vào giỏ hàng!");
                        updateCartQuantity(response.cartQuantity);
                    } else {
                        showNotification(response.message, true);
                    }
                },
                error: function (xhr, status, error) {
                    console.error(error);
                    showNotification("Vui lòng đăng nhập để thêm sản phẩm vào giỏ hàng", true);
                }
            });
        });
    });
</script>

<style>
    .notification {
        position: fixed;
        top: 20px;
        right: 20px;
        background-color: #7FAD39; /* Màu nền xanh lá cho thông báo thành công */
        color: white;
        padding: 10px;
        border-radius: 5px;
        display: none; /* Ban đầu ẩn */
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        z-index: 1000;
    }

        .notification.error {
            background-color: #f44336; /* Màu nền đỏ cho thông báo lỗi */
        }

</style>
