@model CosmeticMVC.Areas.Admin.ViewModels.ProductCreateViewModel

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "_LayoutAdmin";
}

<style>
    #layoutSidenav_content {
        padding-left: 450px !important;
    }

    main .container-fluid.px-4 {
        padding-top: 550px !important;
    }
</style>

<h1 class="mt-4">Thêm sản phẩm mới</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" asp-area="Admin">Sản phẩm</a></li>
    <li class="breadcrumb-item active">Thêm sản phẩm mới</li>
</ol>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-plus me-1"></i>
        Thêm sản phẩm mới
    </div>
    <div class="card-body">
        <form asp-action="Create" asp-controller="Products" asp-area="Admin" method="post" enctype="multipart/form-data" id="productForm">
            <div class="row">
                <!-- Sản phẩm -->
                <div class="col-lg-12">

                    <div class="form-group mb-3">
                        <label asp-for="Name">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Price">Giá <span class="text-danger">*</span></label>
                        <input asp-for="Price" class="form-control" type="number" min="0" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Quantity">Số lượng <span class="text-danger">*</span></label>
                        <input asp-for="Quantity" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Exp">Ngày sản xuất <span class="text-danger">*</span></label>
                        <input asp-for="Exp" type="date" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Exp" class="text-danger"></span>
                    </div>


                    <div class="form-group mb-3">
                        <label asp-for="IdBrand">Thương hiệu <span class="text-danger">*</span></label>
                        <select asp-for="IdBrand" class="form-control" asp-items="ViewBag.IdBrand"></select>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="IdCategory">Loại sản phẩm <span class="text-danger">*</span></label>
                        <select asp-for="IdCategory" class="form-control" asp-items="ViewBag.IdCategory"></select>
                    </div>

                    <div class="form-row avatar-row">
                        <div class="avatar-container">
                            <input asp-for="IdImage" type="file" id="productUpload" name="Product" class="form-control-file" />
                            <span asp-validation-for="IdImage" class="text-danger"></span>
                        </div>
                    </div>

                </div>

                <!-- Mô tả sản phẩm -->
                <div class="col-lg-12">
                    <div class="form-group">
                        <label for="Description" class="col-2 col-form-label-sm text-right">Mô tả</label>
                        <textarea asp-for="Description" id="editor1" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

            </div>

            <!-- Submit Section -->
            <div class="row mt-4">
                <div class="col-lg-12 text-end">
                    <button type="submit" class="btn btn-primary me-2">Tạo sản phẩm</button>
                    <a asp-action="Index" class="btn btn-secondary">Trở lại danh sách</a>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const avatarInput = document.getElementById('productUpload');

        // Check if a valid file is selected
        avatarInput.addEventListener('change', function () {
            const file = this.files[0];

            // Validate the file type (image)
            if (file) {
                const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
                if (!allowedTypes.includes(file.type)) {
                    alert('Vui lòng chọn một tệp ảnh hợp lệ (JPG, PNG, GIF).');
                    this.value = ''; // Reset the file input if invalid file
                }
            }
        });

        // CKEditor setup (no changes needed)
        CKEDITOR.replace('editor1', {
            height: 300,
        });

        // Sync CKEditor data with the form textarea before submitting
        $('#productForm').on('submit', function () {
            for (instance in CKEDITOR.instances) {
                CKEDITOR.instances[instance].updateElement();
            }
        });
    });

</script>
