@model CosmeticMVC.Areas.Admin.ViewModels.ProductCreateViewModel

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "_LayoutAdmin";
}

<style>
    /* Đảm bảo các style responsive của bạn được áp dụng */
    #layoutSidenav_content {
        padding-left: 450px !important;
    }

    main .container-fluid.px-4 {
        padding-top: 550px !important;
    }

    .responsive-table {
        list-style-type: none;
        padding: 0;
        margin: 0;
    }
    .table-header {
        display: flex;
        background-color: #95A5A6;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }
    .table-row {
        display: flex;
        padding: 25px 30px;
        background-color: #ffffff;
        box-shadow: 0px 0px 9px 0px rgba(0,0,0,0.1);
        margin-bottom: 25px;
    }
    .col {
        padding: 10px;
        flex: 1;
    }
</style>

<style>
    .form-container {
        padding-top: 30px;
        padding-bottom: 30px;
    }

    .form-group label {
        font-weight: bold;
        margin-bottom: 8px;
    }

    .form-row {
        margin-bottom: 20px;
    }

.avatar-container {
    margin-top: 20px;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.avatar-container input[type="file"] {
    flex: 1;
    padding: 8px;
}

.preview-img {
    margin-top: 10px;
    border: 2px solid #ddd;
    border-radius: 8px;
    width: 100px;
    height: 100px;
    object-fit: cover;
    display: none; /* Ban đầu ẩn */
}

.btn-browse {
    margin-left: 10px;
    padding: 8px 16px;
    background-color: #4CAF50;
    border: none;
    border-radius: 8px;
    color: white;
    cursor: pointer;
}

.btn-browse:hover {
    background-color: #45a049;
}


    .form-group input,
    .form-group select,
    .form-group textarea {
        border-radius: 8px;
        padding: 12px;
        font-size: 16px;
        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
    }

    /* Tăng chiều cao cho dropdown */
    .form-group select {
        height: 45px;
    }

    .btn-submit {
        width: 100%;
        padding: 12px;
        font-size: 16px;
        border-radius: 8px;
    }

    .btn-submit:hover {
        background-color: #4CAF50;
    }
</style>

<h1 class="mt-4">Thêm sản phẩm mới</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" asp-area="Admin">Sản phẩm</a></li>
    <li class="breadcrumb-item active">Thêm sản phẩm mới</li>
</ol>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-plus me-1"></i>
        Thêm sản phẩm mới
    </div>
    <div class="card-body form-container">
        <form asp-action="Create" asp-controller="Products" asp-area="Admin" method="post" enctype="multipart/form-data" id="productForm">
            <div class="row">
                <!-- Tên sản phẩm -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Name">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                <!-- Giá sản phẩm -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Price">Giá <span class="text-danger">*</span></label>
                        <input asp-for="Price" class="form-control" type="number" min="0" step="0.01" placeholder="Nhập giá sản phẩm" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Số lượng -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Quantity">Số lượng <span class="text-danger">*</span></label>
                        <input asp-for="Quantity" class="form-control" type="number" min="0" placeholder="Nhập số lượng" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>
                </div>

                <!-- Ngày sản xuất -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Exp">Ngày sản xuất <span class="text-danger">*</span></label>
                        <input asp-for="Exp" type="date" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Exp" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Thương hiệu -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdBrand">Thương hiệu <span class="text-danger">*</span></label>
                        <select asp-for="IdBrand" class="form-control" asp-items="ViewBag.IdBrand"></select>
                    </div>
                </div>

                <!-- Loại sản phẩm -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdCategory">Loại sản phẩm <span class="text-danger">*</span></label>
                        <select asp-for="IdCategory" class="form-control" asp-items="ViewBag.IdCategory"></select>
                    </div>
                </div>
            </div>

            <!-- Chọn ảnh sản phẩm -->
            <div class="avatar-container">
                <label for="productUpload" class="form-label" style="flex: 0 0 100px;">Chọn ảnh</label>
                <input asp-for="IdImage" type="file" id="productUpload" name="Product" class="form-control-file" />
                <img id="imagePreview" class="preview-img" />
            </div>


            <!-- Mô tả sản phẩm -->
            <div class="form-group">
                <label for="Description" class="col-12 col-form-label">Mô tả sản phẩm</label>
                <textarea asp-for="Description" id="editor1" class="form-control" placeholder="Nhập mô tả sản phẩm"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- Submit Section -->
            <div class="row mt-4">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary btn-submit">Tạo sản phẩm</button>
                </div>
                <div class="col-12 mt-2">
                    <a asp-action="Index" class="btn btn-secondary w-100">Trở lại danh sách</a>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const avatarInput = document.getElementById('productUpload');
        const imagePreview = document.getElementById('imagePreview');

        avatarInput.addEventListener('change', function () {
            const file = this.files[0];

            if (file) {
                const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
                if (!allowedTypes.includes(file.type)) {
                    alert('Vui lòng chọn một tệp ảnh hợp lệ (JPG, PNG, GIF).');
                    this.value = ''; 
                    imagePreview.style.display = 'none';
                } else {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        imagePreview.src = e.target.result;
                        imagePreview.style.display = 'block';
                    };
                    reader.readAsDataURL(file);
                }
            }
        });

        CKEDITOR.replace('editor1', {
            height: '300px',
            filebrowserBrowseUrl: '/plugin/ckfinder/ckfinder.html',
            filebrowserImageBrowseUrl: '/plugin/ckfinder/ckfinder.html?type=Images',
            filebrowserUploadUrl: '/plugin/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Files',
            filebrowserImageUploadUrl: '/plugin/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Images'
        });

        $('#productForm').on('submit', function () {
            for (instance in CKEDITOR.instances) {
                CKEDITOR.instances[instance].updateElement();
            }
        });
    });
</script>
