@model CosmeticMVC.Data.Brand

@{
    ViewData["Title"] = "Tạo thương hiệu";
    Layout = "_LayoutAdmin";
}

<style>
    /* Điều chỉnh lại padding và bố cục cho giao diện đẹp hơn */
    #layoutSidenav_content {
        padding-left: 450px !important;
    }

    main .container-fluid.px-4 {
        padding-top: 550px !important;
    }
</style>

<h1 class="mt-4">Tạo thương hiệu mới</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-controller="Brands" asp-action="Index" asp-area="Admin">Thương hiệu</a></li>
    <li class="breadcrumb-item active">Tạo thương hiệu</li>
</ol>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-plus me-1"></i>
        Tạo thương hiệu mới
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="row">
                <!-- Thông tin thương hiệu -->
                <div class="col-lg-12">

                    <!-- Tên thương hiệu -->
                    <div class="form-group mb-3">
                        <label asp-for="Name">Tên thương hiệu <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Ngày bắt đầu -->
                    <div class="form-group mb-3">
                        <label asp-for="Datebegin">Ngày bắt đầu <span class="text-danger">*</span></label>
                        <input asp-for="Datebegin" type="date" class="form-control" />
                        <span asp-validation-for="Datebegin" class="text-danger"></span>
                    </div>

                    <!-- Ảnh thumbnail -->
                    <div class="form-group mb-3">
                        <label asp-for="Thumbnail">Ảnh thương hiệu <span class="text-danger">*</span></label>
                        <input asp-for="Thumbnail" type="file" class="form-control-file" />
                        <span asp-validation-for="Thumbnail" class="text-danger"></span>
                    </div>

                </div>
            </div>

            <!-- Phần Submit -->
            <div class="row mt-4">
                <div class="col-lg-12 text-end">
                    <button type="submit" class="btn btn-primary me-2">Tạo thương hiệu</button>
                    <a asp-action="Index" class="btn btn-secondary">Trở lại danh sách</a>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Thêm các logic JavaScript nếu cần
    });
</script>
