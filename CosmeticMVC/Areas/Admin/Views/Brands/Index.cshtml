@model IEnumerable<CosmeticMVC.Data.Brand>

@{
    ViewData["Title"] = "Brands";
    Layout = "_LayoutAdmin";
}
<style>
    main .container-fluid.px-4 {
        padding-top: 0px !important;
    }
    #layoutSidenav_content {
        padding-left: 400px !important; /* Adjust layout padding */
    }
</style>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-table me-1"></i>
        Danh sách thương hiệu
    </div>
    <div class="card-body">
        <div style="overflow-x: auto; max-width: 100%;">
            <table id="datatablesSimple" class="table table-bordered table-hover" style="white-space: nowrap;">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Datebegin)</th>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Thumbnail)</th>
                        <th>Chức năng</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Datebegin)</th>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Thumbnail)</th>
                        <th>Chức năng</th>
                    </tr>
                </tfoot>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Datebegin)</td>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Thumbnail)</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
