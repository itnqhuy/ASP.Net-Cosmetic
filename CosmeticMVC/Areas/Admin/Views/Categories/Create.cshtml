@model CosmeticMVC.Data.Category

@{
    ViewData["Title"] = "Tạo danh mục";
    Layout = "_LayoutAdmin";
}

<style>
    /* Bố cục tổng thể */
    #layoutSidenav_content {
        padding-left: 0px !important;
    }

    main .container-fluid.px-4 {
        padding-top: 0px !important;
    }

    .card {
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background-color: #007bff;
        color: #fff;
        font-size: 18px;
        font-weight: bold;
    }

    .form-group label {
        font-weight: bold;
        margin-bottom: 8px;
        display: inline-block;
    }

    .form-group input, .form-group textarea, .form-group select {
        height: 45px;
        border-radius: 8px;
        padding: 10px;
        font-size: 16px;
        box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.1);
        border: 1px solid #ced4da;
    }

        .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
            border-color: #007bff;
            box-shadow: 0px 0px 5px rgba(0, 123, 255, 0.5);
        }

    /* Điều chỉnh checkbox trong form-check */
    .form-check-input {
        width: 20px;
        height: 20px;
        margin-top: 0; /* Canh giữa với label */
        margin-right: 10px; /* Khoảng cách giữa checkbox và label */
    }

    .form-check-label {
        font-size: 16px; /* Kích thước chữ vừa phải */
        font-weight: bold;
    }

    .form-check {
        display: flex;
        align-items: center; /* Căn giữa checkbox và label theo chiều dọc */
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        padding: 12px 20px;
        font-size: 16px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
        }

    .btn-secondary {
        padding: 12px 20px;
        font-size: 16px;
        border-radius: 8px;
    }

    .text-danger {
        font-size: 14px;
    }

    .form-row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
    }

        .form-row .form-group {
            flex: 1;
        }
</style>

<h1 class="mt-4">Tạo danh mục</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-controller="Categories" asp-action="Index" asp-area="Admin">Danh mục</a></li>
    <li class="breadcrumb-item active">Tạo danh mục</li>
</ol>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-plus me-1"></i>
        Tạo danh mục mới
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <!-- Row 1 -->
            <div class="form-row">
                <!-- Tên danh mục -->
                <div class="form-group">
                    <label asp-for="Name">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Mô tả meta -->
                <div class="form-group">
                    <label asp-for="Meta">Meta</label>
                    <input asp-for="Meta" class="form-control" />
                    <span asp-validation-for="Meta" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 2 -->
            <div class="form-row">
                <!-- Thứ tự danh mục -->
                <div class="form-group">
                    <label asp-for="Order">Thứ tự</label>
                    <input asp-for="Order" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Order" class="text-danger"></span>
                </div>

                <!-- Ngày tạo -->
                <div class="form-group">
                    <label asp-for="Datebegin">Ngày tạo <span class="text-danger">*</span></label>
                    <input asp-for="Datebegin" type="date" class="form-control" />
                    <span asp-validation-for="Datebegin" class="text-danger"></span>
                </div>
            </div>

            <!-- Row 3 -->
            <div class="form-check mb-4">
                <input asp-for="Hide" class="form-check-input" />
                <label asp-for="Hide" class="form-check-label">Ẩn danh mục</label>
            </div>

            <!-- Phần submit -->
            <div class="row mt-4">
                <div class="col-lg-12 text-end">
                    <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save"></i> Tạo danh mục</button>
                    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Trở lại</a>
                </div>
            </div>
        </form>
    </div>
</div>
